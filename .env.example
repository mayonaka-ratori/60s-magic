# 接続情報はこのPCだけで使用します。VITE_ を名前の先頭に付けないでください。
PORT=5173
HOST=127.0.0.1
JEV_API_KEY=
JEV_MODEL=jev-1.13.0
# local: このPCで認識 / google: Googleへ音声を送る / off: 使用しない
SPEECH_PROVIDER=local
# 通常は空欄のままで使用できます。
LOCAL_SPEECH_PYTHON=
LOCAL_SPEECH_MODEL=
# auto: GPUがあればGPU、なければCPU / cuda / cpu
LOCAL_SPEECH_DEVICE=auto
# CPUで認識するときに使うCPUの数。空欄なら半分（2〜6）
LOCAL_SPEECH_THREADS=
# 認識モデル。kotoba-v2.0（日本語向け・大きい・GPU向け）/ medium / small / base（小さいほど速く、聞き取りは粗い）
# 空欄なら Windows は kotoba-v2.0、Mac は small。変えたら npm run setup:speech をもう一度実行する
LOCAL_SPEECH_MODEL_ID=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us
# Google Cloud の認証ファイルへの絶対パス。ファイル自体は公開しません。
GOOGLE_APPLICATION_CREDENTIALS=
