# 接続情報はこのPCだけで使用します。VITE_ を名前の先頭に付けないでください。
PORT=5173
HOST=127.0.0.1
JEV_API_KEY=
JEV_MODEL=jev-1.13.0
# local: このPCで認識 / google: Googleへ音声を送る / off: 使用しない
SPEECH_PROVIDER=local
# 通常は空欄のままで使用できます。
LOCAL_SPEECH_PYTHON=
LOCAL_SPEECH_MODEL=
# auto: PCに合わせて選ぶ / faster: faster-whisper / mlx: MacのGPU
LOCAL_SPEECH_ENGINE=auto
# auto: GPUがあればGPU、なければCPU / cuda / cpu / gpu（MacのGPU）
LOCAL_SPEECH_DEVICE=auto
# CPUで認識するときに使うCPUの数。空欄なら半分（2〜6）
LOCAL_SPEECH_THREADS=
# 認識モデル。末尾が -mlx のものは Apple Silicon の Mac 専用。
#   kotoba-v2.0-mlx / large-v3-turbo-mlx / medium-mlx / small-mlx …… MacのGPUで動かす
#   kotoba-v2.0 / medium / small / base …………………………………… NVIDIAのGPUかCPUで動かす
# 空欄なら Apple Silicon の Mac は kotoba-v2.0-mlx、Windows は kotoba-v2.0、それ以外は small。
# 変えたら npm run setup:speech をもう一度実行する。速さは npm run benchmark:speech で比べられる
LOCAL_SPEECH_MODEL_ID=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us
# Google Cloud の認証ファイルへの絶対パス。ファイル自体は公開しません。
GOOGLE_APPLICATION_CREDENTIALS=
