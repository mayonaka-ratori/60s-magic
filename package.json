{
  "name": "create-magic60s",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts --production",
    "test": "vitest run",
    "test:browser": "playwright test",
    "setup:assets": "node scripts/setup-assets.mjs",
    "setup:speech": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-speech.ps1",
    "test:speech": "tsx scripts/test-local-speech.ts",
    "test:chants": "tsx scripts/test-chant-dictionary.ts",
    "audio:check": "node scripts/check-audio.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "9.27.1",
    "@fontsource/noto-sans-jp": "5.3.0",
    "@fontsource/noto-serif-jp": "5.3.0",
    "@google-cloud/speech": "8.1.0",
    "@mediapipe/tasks-vision": "0.10.32",
    "dotenv": "16.6.1",
    "express": "5.2.1",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/express": "5.0.3",
    "@types/node": "22.19.7",
    "@types/ws": "8.18.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
